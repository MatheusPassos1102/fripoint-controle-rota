# ------------------------------------------------------------------
# Fripoint Route Intelligence — variáveis de ambiente do serviço
# Copie para .env e preencha. NUNCA versione o .env.
# Nenhuma integração externa é acionada sem estas chaves preenchidas.
# ------------------------------------------------------------------

# Claude API (Anthropic)
ANTHROPIC_API_KEY=
# Modelo padrão para todas as chamadas (análise de fotos, classificação, instrutor, relatório)
CLAUDE_MODEL=claude-opus-5-5
# Ativa o fallback server-side em caso de recusa do classificador de segurança (true/false)
CLAUDE_SERVER_FALLBACK=true

# Supabase
SUPABASE_URL=
# Chave service_role — usada SOMENTE pelo serviço backend (nunca em cliente/n8n público)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidencias

# Serviço HTTP (chamado pelo n8n)
PORT=8080
# Token compartilhado: n8n envia em "Authorization: Bearer <token>"
SERVICE_API_TOKEN=

# n8n (webhooks que o serviço aciona — opcionais; se vazios, o serviço não notifica)
N8N_WEBHOOK_ROUTE_CLOSED=
N8N_WEBHOOK_ALERT=
N8N_WEBHOOK_INSTRUCTOR=

# Fase de operação do POP (secao 5.1): A = auditoria silenciosa, B = instrutor interativo
# Fase B so pode ser ativada apos autorizacao formal (ver docs/03-pontos-de-aprovacao.md)
OPERATION_PHASE=A

# Fuso horario operacional
TZ=America/Sao_Paulo
